{
  "name": "zipnative-cli",
  "version": "1.1.0",
  "description": "Official CLI for zipnative — create deterministic, reproducible ZIP archives (store/deflate, streaming, worker-parallel), list and inspect without extracting, extract with secure-by-default guards (zip-slip, zip-bomb, symlink, duplicate-path and device-name refusals), verify integrity in one call, stream unseekable input, modify archives without recompression, and drive it all from AI agents through a stable --json contract carrying zipnative's frozen error codes. ISO/IEC 21320-1:2015 conformance validated in CI. Zero extra runtime dependencies.",
  "type": "module",
  "bin": {
    "zipnative": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES.md",
    "AGENTS.md",
    "llms.txt",
    "docs/data/errors.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json --noEmit",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts",
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs --fast",
    "check:package": "node scripts/package-files.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "sync:engine": "node scripts/sync-engine-data.mjs",
    "corpus:zip": "node scripts/generate-zip-corpus.mjs",
    "validate:zip": "npm run build && npm run corpus:zip && node scripts/validate-zip.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "hooks:uninstall": "node scripts/install-git-hooks.mjs --uninstall",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "zip",
    "unzip",
    "zip64",
    "archive",
    "compression",
    "decompression",
    "deflate",
    "inflate",
    "cli",
    "zipnative",
    "zero-dependency",
    "typescript",
    "streaming",
    "random-access",
    "incremental",
    "deterministic",
    "reproducible-builds",
    "zip-slip",
    "zip-bomb",
    "secure-by-default",
    "iso-21320",
    "conformance",
    "crc32",
    "verify",
    "extract",
    "command-line",
    "shell-completions",
    "powershell-completion",
    "json-output",
    "json-schema",
    "ai-agent",
    "agentic",
    "ai-governance",
    "hitl",
    "human-in-the-loop",
    "automation",
    "batch",
    "pipeline",
    "llms-txt",
    "sbom",
    "supply-chain"
  ],
  "author": "Nizoka <hello@pdfnative.dev> (https://pdfnative.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nizoka/zipnative-cli.git"
  },
  "homepage": "https://github.com/Nizoka/zipnative-cli#readme",
  "bugs": {
    "url": "https://github.com/Nizoka/zipnative-cli/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://plika.app"
  },
  "engines": {
    "node": "^22.17.1 || >=24.4.1"
  },
  "packageManager": "npm@10.9.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "zipnative": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "vite": "8.2.2"
  }
}
