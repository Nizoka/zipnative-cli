# Dependencies
node_modules/

# Build output
dist/

# Coverage
coverage/

# Test output (veraZIP corpus + reports — regenerated by `npm run corpus:zip`)
test-output/

# Sample output (generated archives — never committed)
samples/output/
*.tsbuildinfo

# AI-agent issue drafts are local until a human files them upstream
# (same rule as the engine repository) — only the README and the template are tracked
.github/drafts/*
!.github/drafts/README.md
!.github/drafts/TEMPLATE.md

# Claude Code: the shared settings and the release-audit skill are tracked;
# per-machine settings and worktrees are not
.claude/settings.local.json
.claude/worktrees/

# Release-audit ledgers (/release-audit) — local, never committed
.audit/

# Environment files — never commit secrets
.env
.env.*
!.env.example

# OS and editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json

# npm (the project .npmrc IS tracked: ignore-scripts, engine-strict, audit level)
*.tgz
